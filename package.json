{
  "name": "wormhole",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "prepare": "husky install",
    "wormhole:lint": "ng lint --fix",
    "wormhole:format": "standard --fix",
    "lint": "ng lint",
    "serve:wormhole": "ng serve Wormhole",
    "serve:vehicles": "ng serve vehicles",
    "serve:weather": "ng serve weather",
    "start:wormhole": "ng serve Wormhole -o --port 4200",
    "start:vehicles": "ng serve vehicles -o --port 3000",
    "start:weather": "ng serve weather -o --prot 3300",
    "start:cityWeather": "ng serve cityWeather -o --port 3600",
    "start:all": "concurrently \"npm run start:wormhole\" \"npm run start:vehicles\"  \"npm run start:weather\" \"npm run start:cityWeather\"",
    "run:all": "node node_modules/@angular-architects/module-federation/src/server/mf-dev-server.js",
    "compodoc": "npx compodoc -p tsconfig.doc.json"
  },
  "private": true,
  "dependencies": {
    "@angular-architects/module-federation": "^22.0.0",
    "@angular/animations": "^22.2.3",
    "@angular/cdk": "^22.2.4",
    "@angular/common": "^22.2.3",
    "@angular/compiler": "^22.2.3",
    "@angular/core": "^22.2.3",
    "@angular/fire": "22.0.0-canary.20261023210158.sha-29ca012",
    "@angular/forms": "^22.2.3",
    "@angular/material": "^22.2.4",
    "@angular/platform-browser": "^22.2.3",
    "@angular/platform-browser-dynamic": "^22.2.3",
    "@angular/router": "^22.2.3",
    "@ngneat/transloco": "^4.3.0",
    "@ngrx/effects": "^22.0.1",
    "@ngrx/operators": "^22.0.1",
    "@ngrx/store": "^22.0.1",
    "@ngrx/store-devtools": "^22.0.1",
    "aws-amplify": "^6.0.5",
    "firebase": "^12.18.0",
    "ngx-webstorage": "^22.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular-devkit/architect": "^0.2202.4",
    "@angular-devkit/build-angular": "^22.2.4",
    "@angular-devkit/core": "^22.2.4",
    "@angular-eslint/builder": "^22.6.0",
    "@angular-eslint/eslint-plugin": "^22.6.0",
    "@angular-eslint/eslint-plugin-template": "^22.6.0",
    "@angular-eslint/schematics": "^22.6.0",
    "@angular-eslint/template-parser": "^22.6.0",
    "@angular/cli": "~22.2.4",
    "@angular/compiler-cli": "^22.2.3",
    "@ngrx/eslint-plugin": "^22.0.1",
    "@types/jasmine": "~4.0.0",
    "@typescript-eslint/eslint-plugin": "^8.33.1",
    "@typescript-eslint/parser": "^8.33.1",
    "eslint": "^9.28.0",
    "husky": "^8.0.2",
    "istanbul-lib-instrument": "^6.0.3",
    "jasmine-core": "~4.3.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.1.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.0.0",
    "ng-packagr": "^22.2.5",
